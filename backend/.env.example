# Server
NODE_ENV=development
PORT=5100
CLIENT_URL=http://localhost:3100
SERVER_BASE_URL=http://localhost:5100

# MongoDB
# Add this project's MongoDB connection string before starting the backend.
MONGODB_URI=mongodb+srv://heymailer100_db_user:Oluwabukola1999@heymailer.spygfhj.mongodb.net/
MONGODB_DB_NAME=heymailer

# Auth (single admin account)
JWT_SECRET=some_kind_login_to_be_login
JWT_EXPIRES_IN=7d
COOKIE_NAME=heymailer_token
COOKIE_SAME_SITE=lax
SMTP_CREDENTIALS_ENCRYPTION_KEY=lovely_random_secret_at_least_32_words_and_chars_long

# Admin bootstrap — used only by `npm run seed` to create the first admin.
ADMIN_EMAIL=admin@heymailer.com
ADMIN_PASSWORD=WatchMe123!
ADMIN_NAME=HeyMailer Admin
AUTO_SEED=true

# Mail transport. Use Mailjet API on hosts that block outbound SMTP (such as Render Free).
PLATFORM_MAIL_PROVIDER=resend
PLATFORM_FROM_EMAIL=
PLATFORM_FROM_NAME=HeyMailer
PLATFORM_REPLY_TO=
MAIL_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=HeyMailer
# Use https://api.us.mailjet.com only if your Mailjet account is on US architecture.
MAILJET_API_BASE_URL=https://api.mailjet.com

# Resend HTTPS API (verify RESEND_FROM_EMAIL's domain in Resend first)
RESEND_API_KEY=long_random_string_from_resend_dashboard
RESEND_FROM_EMAIL=heymailer100@gmail.com
RESEND_FROM_NAME=HeyMailer

# Optional Google SMTP fallback (set MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FORCE_IPV4=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HeyMailer

# Gmail inbox processing for bounce and complaint reports
BOUNCE_PROCESSING_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
BOUNCE_POLL_INTERVAL_MS=300000

# Sending queue
QUEUE_BATCH_SIZE=5
QUEUE_BATCH_DELAY_MS=120000
QUEUE_POLL_INTERVAL_MS=10000

# App links used inside email templates
WEBSITE_URL=https://roundsaving.netlify.app
SAVINGS_URL=https://roundsaving.netlify.app/savings
THRIFT_URL=https://roundsaving.netlify.app/thrift
TELEGRAM_URL=https://t.me/heymailer_support
SUPPORT_EMAIL=savings.heymailer@gmail.com

# Used to sign unsubscribe links so they can't be forged
UNSUBSCRIBE_SECRET=change_this_to_a_long_random_string
