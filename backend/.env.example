# Server
NODE_ENV=development
PORT=5100
FRONTEND_URL=http://localhost:3100
SERVER_BASE_URL=http://localhost:5100

# MongoDB
# Add this project's MongoDB connection string before starting the backend.
MONGODB_URI=
MONGODB_DB_NAME=heymailer

# Render Redis/Key Value connection URL. Required in production so rate
# limits and campaign locks are shared by every backend instance.
REDIS_URL=

# Auth (single admin account)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=heymailer_token
COOKIE_SAME_SITE=lax
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Admin bootstrap — used only by `npm run seed` to create the first admin.
ADMIN_EMAIL=admin@heymailer.com
ADMIN_PASSWORD=
ADMIN_NAME=HeyMailer Admin
AUTO_SEED=true

# Mail transport. Use Mailjet API on hosts that block outbound SMTP (such as Render Free).
PLATFORM_MAIL_PROVIDER=resend
PLATFORM_FROM_EMAIL=
PLATFORM_FROM_NAME=HeyMailer
PLATFORM_REPLY_TO=
MAIL_PROVIDER=resend
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=HeyMailer
# Use https://api.us.mailjet.com only if your Mailjet account is on US architecture.
MAILJET_API_BASE_URL=https://api.mailjet.com

# Resend HTTPS API (verify RESEND_FROM_EMAIL's domain in Resend first)
RESEND_API_KEY=
# Must use a domain verified in Resend; Gmail/Outlook/Yahoo addresses cannot be used as From addresses.
RESEND_FROM_EMAIL=mail@your-verified-domain.example
RESEND_FROM_NAME=HeyMailer
# Optional fallback. A super admin can save this signing secret securely in
# Deliverability settings instead. Webhook URL: SERVER_BASE_URL/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Optional Google SMTP fallback (set MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FORCE_IPV4=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HeyMailer

# Gmail inbox processing for bounce and complaint reports
BOUNCE_PROCESSING_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
BOUNCE_POLL_INTERVAL_MS=300000

# Controlled seed-inbox placement scanner
PLACEMENT_PROCESSING_ENABLED=true
PLACEMENT_POLL_INTERVAL_MS=60000
PLACEMENT_TEST_TIMEOUT_MS=900000

# Sending queue
QUEUE_BATCH_SIZE=5
QUEUE_BATCH_DELAY_MS=120000
QUEUE_POLL_INTERVAL_MS=10000
QUEUE_LOCK_TTL_MS=300000

# App links used inside email templates
WEBSITE_URL=https://www.heymailer.example
SAVINGS_URL=https://www.heymailer.example/savings
THRIFT_URL=https://www.heymailer.example/thrift
TELEGRAM_URL=https://t.me/heymailer_support
SUPPORT_EMAIL=savings.heymailer@gmail.com

# Used to sign unsubscribe links so they can't be forged
UNSUBSCRIBE_SECRET=
